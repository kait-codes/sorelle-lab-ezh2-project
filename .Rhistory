groups <- rep(1:15, each = 4)
dge <- DGEList(counts_taz, group = groups) # creating DGE list
dge <- DGEList(counts, group = groups) # creating DGE list
keep <- filterByExpr(dge) #filtering out low counts
dge <- dge[keep, , keep.lib.sizes = FALSE]
norm_counts <- normLibSizes(dge)
View(norm_counts)
test <- as.data.frame(norm_counts)
View(test)
write.csv(norm_df, paste0(data_dir, '/exp_counts/norm_counts.csv'))
norm_df <- as.data.frame(norm_counts)
write.csv(norm_df, paste0(data_dir, '/exp_counts/norm_counts.csv'))
metadata <- read.csv(file.path(data_dir, 'samples.csv'),
stringsAsFactors = TRUE)
View(metadata)
design <- model.matrix( ~ treatment + cell_line, data = metadata)
rownames(design) <- colnames(norm_counts)
design
y <- estimateDisp(norm_counts, design, robust = TRUE)
fit <- glmQLFit(y, design, robust = TRUE)
qlt <- glmQLFTest(fit)
View(qlt)
topgenes<-topTags(qlt, n=dim(counts)[[1]])
#How many are significant between the cell lines?
table(topgenes$table$FDR<0.05)
View(topgenes)
plotBCV(y)
png(paste0(out_dir,
"/samples/all_est_disp.png"),
width = 800,
height = 600,
units = "px")
plotBCV(y)
dev.off()

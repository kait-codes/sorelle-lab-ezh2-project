res_df <- do.call(rbind, res_df) %>%
mutate(minuslog10padj = -log10(p.adjust))
# filter for significance
res_df_sig <- res_df %>%
filter(p.adjust < padj_cutoff & Count > genecount_cutoff)
# save results
